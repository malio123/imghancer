# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "imghancer"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# enhance ui labels
NEXT_PUBLIC_ENHANCE_MODEL_LABEL = "Topaz Image Upscale"
NEXT_PUBLIC_ENHANCE_PROVIDER_LABEL = "Replicate"

# database
DATABASE_URL = ""
DATABASE_PROVIDER = "postgresql"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""

# enhance provider
# ENHANCE_PROVIDER = local | replicate
ENHANCE_PROVIDER = "replicate"

# replicate
REPLICATE_API_TOKEN = ""
REPLICATE_MODEL = "topazlabs/image-upscale"
REPLICATE_MODEL_VERSION = ""
REPLICATE_IMAGE_INPUT_KEY = "image"
REPLICATE_SCALE_INPUT_KEY = "upscale_factor"
REPLICATE_SCALE_FORMAT = "nx"
REPLICATE_EXTRA_INPUTS = "{\"enhance_model\":\"Low Resolution V2\",\"face_enhancement\":true,\"subject_detection\":\"Foreground\",\"face_enhancement_creativity\":0.5}"

# supabase storage
SUPABASE_BUCKET_PUBLIC = "true"
